<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings>
      <setting id="name">NeoExplorerApp</setting>
      <setting id="description">Hosts the NeoExplorer control</setting>
      <setting id="template">application</setting>
      <setting id="main_widget">main_window</setting>
      <setting id="module_namespace" />
      <setting id="module_name">neo_explorer_app</setting>
      <setting id="main_classname">NeoExplorerApp</setting>
      <setting id="output_dir" />
      <setting id="builder_namespace">custom_widgets</setting>
      <setting id="output_dir2" />
      <setting id="generate_code_onsave">False</setting>
      <setting id="use_i18n">False</setting>
      <setting id="all_ids_attributes">False</setting>
      <setting id="import_tkvariables">False</setting>
      <setting id="use_ttk_styledefinition_file">False</setting>
      <setting id="use_window_centering_code">True</setting>
      <setting id="ttk_style_definition_file" />
    </settings>
    <customwidgets />
    <resources />
  </project>
  <object class="tk.Toplevel" id="main_window" named="True">
    <property name="height">500</property>
    <property name="title" translatable="yes">Near Earth Object Tracker</property>
    <property name="width">800</property>
    <containerlayout manager="pack">
      <property name="propagate">false</property>
    </containerlayout>
    <child>
      <object class="ttk.Frame" id="frame_top" named="True">
        <property name="height">68</property>
        <property name="relief">ridge</property>
        <property name="width">500</property>
        <layout manager="pack">
          <property name="anchor">w</property>
          <property name="expand">false</property>
          <property name="fill">x</property>
          <property name="side">top</property>
        </layout>
        <containerlayout manager="grid">
          <property name="propagate">false</property>
        </containerlayout>
        <child>
          <object class="ttk.Label" id="label1">
            <property name="text" translatable="yes">Start Date</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">4</property>
              <property name="pady">5</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Entry" id="entry_start_date" named="True">
            <property name="placeholder">YYYY-MM-DD</property>
            <property name="width">15</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">0 50</property>
              <property name="pady">10 5</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="label2">
            <property name="text" translatable="yes">End Date</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Entry" id="entry_end_date" named="True">
            <property name="placeholder">YYYY-MM-DD</property>
            <property name="width">15</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">0 50</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="label3">
            <property name="text" translatable="yes">Faintest Magnitude</property>
            <layout manager="grid">
              <property name="column">2</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Spinbox" id="spinbox_faintest_magnitude" named="True">
            <property name="from_">9</property>
            <property name="increment">1</property>
            <property name="to">34</property>
            <property name="width">4</property>
            <layout manager="grid">
              <property name="column">3</property>
              <property name="padx">2 50</property>
              <property name="pady">10 5</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Checkbutton" id="checkbutton_potentially_hazardous" named="True">
            <property name="text" translatable="yes">Potentially Hazardous</property>
            <property name="variable">int:is_potentially_hazardous</property>
            <layout manager="grid">
              <property name="column">4</property>
              <property name="row">0</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Checkbutton" id="checkbutton_sentry_objects" named="True">
            <property name="text" translatable="yes">Sentry Objects</property>
            <property name="variable">int:sentry_objects</property>
            <layout manager="grid">
              <property name="column">4</property>
              <property name="row">1</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Button" id="button_search_for_objects" named="True">
            <property name="text" translatable="yes">Search for Objects</property>
            <layout manager="grid">
              <property name="column">5</property>
              <property name="padx">50 10</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="frame_middle" named="True">
        <property name="height">400</property>
        <property name="width">600</property>
        <layout manager="pack">
          <property name="expand">true</property>
          <property name="fill">both</property>
          <property name="side">top</property>
        </layout>
        <containerlayout manager="pack">
          <property name="propagate">false</property>
        </containerlayout>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="frame_bottom" named="True">
        <property name="height">25</property>
        <property name="relief">solid</property>
        <property name="width">200</property>
        <layout manager="pack">
          <property name="expand">false</property>
          <property name="fill">x</property>
          <property name="side">bottom</property>
        </layout>
        <containerlayout manager="pack">
          <property name="propagate">false</property>
        </containerlayout>
        <child>
          <object class="ttk.Label" id="label_statusbar_message" named="True">
            <property name="text" translatable="yes">Objects found: 0</property>
            <layout manager="pack">
              <property name="expand">true</property>
              <property name="fill">x</property>
              <property name="padx">5 5</property>
              <property name="pady">2 1</property>
              <property name="side">left</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="label4">
            <property name="foreground">gray</property>
            <property name="text" translatable="yes">Data provided by NASA</property>
            <layout manager="pack">
              <property name="padx">10 10</property>
              <property name="side">right</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
